{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/controls/**",
              "components/display/**",
              "components/surface/**",
              "image-slot.js",
              "ui_kits/console/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: DM Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|orange|lcd|outline)$/]",
        "message": "<Badge> variant must be one of 'default' | 'orange' | 'lcd' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|pill|block|mono|icon|iconRight|href|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, pill, block, mono, icon, iconRight, href, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|orange|ghost)$/]",
        "message": "<Button> variant must be one of 'default' | 'orange' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:interactive|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: interactive, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dial'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|variant|size|label|key|ref|className|style|children)$/]",
        "message": "<Dial> doesn't accept that prop. Declared props: value, min, max, onChange, variant, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dial'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|orange)$/]",
        "message": "<Dial> variant must be one of 'default' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dial'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Dial> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grille'] > JSXAttribute > JSXIdentifier[name!=/^(?:pattern|shape|tone|key|ref|className|style|children)$/]",
        "message": "<Grille> doesn't accept that prop. Declared props: pattern, shape, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grille'] > JSXAttribute[name.name='pattern'] > Literal[value!=/^(?:dots|square)$/]",
        "message": "<Grille> pattern must be one of 'dots' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grille'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rect|round)$/]",
        "message": "<Grille> shape must be one of 'rect' | 'round'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grille'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|charcoal)$/]",
        "message": "<Grille> tone must be one of 'light' | 'charcoal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|label|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|orange)$/]",
        "message": "<IconButton> variant must be one of 'default' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LcdScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|value|unit|right|variant|scanlines|children|key|ref|className|style|children)$/]",
        "message": "<LcdScreen> doesn't accept that prop. Declared props: header, value, unit, right, variant, scanlines, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LcdScreen'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|dark)$/]",
        "message": "<LcdScreen> variant must be one of 'default' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Led'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|color|size|key|ref|className|style|children)$/]",
        "message": "<Led> doesn't accept that prop. Declared props: on, color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Led'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:orange|green)$/]",
        "message": "<Led> color must be one of 'orange' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Led'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Led> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|brand|model|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: variant, title, brand, model, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|inset|raised|dark)$/]",
        "message": "<Panel> variant must be one of 'default' | 'inset' | 'raised' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:num|children|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: num, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|onChange|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, step, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:led|ledOn|ledColor|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: led, ledOn, ledColor, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='ledColor'] > Literal[value!=/^(?:orange|green)$/]",
        "message": "<Tag> ledColor must be one of 'orange' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|disabled|label|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, disabled, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
